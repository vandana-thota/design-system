        "$type": "dimension",
        "$value": "{semantic.space.stack-sm}"
      },
      "title-text": {
        "$type": "color",
        "$value": "{semantic.color.text.primary}"
      },
      "body-text": {
        "$type": "color",
        "$value": "{semantic.color.text.secondary}"
      },
      "bg-pressed": {
        "$type": "color",
        "$value": "{semantic.color.bg.surface-secondary}"
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{semantic.color.text.disabled}"
      }
    }
  }
}
